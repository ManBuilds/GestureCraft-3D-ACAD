# Copy to .env (git-ignored). No third-party API keys are needed.
API_KEY=                 # optional: if set, saving/deleting designs needs the X-API-Key header (also set it in frontend/js/config.js)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SERVE_FRONTEND=1         # 1 = the backend also serves ./frontend at http://localhost:8000
